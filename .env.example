# Copy to .env and fill in. .env is git-ignored.
# Docker Hub username that owns the eng-voice-* images (used by docker-compose.prod.yml).
IMAGE_NAMESPACE=your-dockerhub-username
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
POSTGRES_PASSWORD=speak_dev_pw
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
APP_PORT=8080
